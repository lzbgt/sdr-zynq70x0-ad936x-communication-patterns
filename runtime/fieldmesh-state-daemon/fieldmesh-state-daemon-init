#!/bin/sh

DAEMON="${FIELDMESH_STATE_DAEMON_BIN:-/usr/bin/fieldmesh-state-daemon-demo}"
GNSS_REPORTER="${FIELDMESH_GNSS_REPORTER_BIN:-/usr/bin/fieldmesh-gnss-nmea-reporter}"
PIDFILE="${FIELDMESH_STATE_DAEMON_PIDFILE:-/var/run/fieldmesh-state-daemon.pid}"
GNSS_PIDFILE="${FIELDMESH_GNSS_REPORTER_PIDFILE:-/var/run/fieldmesh-gnss-nmea-reporter.pid}"
LOGFILE="${FIELDMESH_STATE_DAEMON_LOGFILE:-/tmp/fieldmesh-state-daemon.ndjson}"
GNSS_LOGFILE="${FIELDMESH_GNSS_REPORTER_LOGFILE:-/tmp/fieldmesh-gnss-nmea-reporter.ndjson}"
LOG_MAX_BYTES="${FIELDMESH_STATE_DAEMON_LOG_MAX_BYTES:-262144}"
GNSS_LOG_MAX_BYTES="${FIELDMESH_GNSS_REPORTER_LOG_MAX_BYTES:-262144}"
LOG_BACKUPS="${FIELDMESH_STATE_DAEMON_LOG_BACKUPS:-2}"
GNSS_LOG_BACKUPS="${FIELDMESH_GNSS_REPORTER_LOG_BACKUPS:-2}"
PORT=55441
REQUESTS=0
TIMEOUT_MS=5000
GNSS_BAUD=9600
GNSS_PPS_LOCK=0
GNSS_MAX_REPORTS=0

read_fwenv() {
    key="$1"
    command -v fw_printenv >/dev/null 2>&1 || return 1
    fw_printenv -n "$key" 2>/dev/null | tr -d '\r\n'
}

read_identity_file() {
    path="$1"
    [ -f "$path" ] || return 1
    value="$(sed -n '1p' "$path" 2>/dev/null | tr -d '\r\n\t ')"
    case "$value" in
        ????????????)
            printf '%s\n' "$value"
            return 0
            ;;
    esac
    return 1
}

read_device_eui() {
    case "${FIELDMESH_DEVICE_EUI:-}" in
        ????????????)
            printf '%s\n' "$FIELDMESH_DEVICE_EUI"
            return 0
            ;;
    esac
    read_identity_file /mnt/jffs2/fieldmesh/device_eui && return 0
    sd_eui="$(read_sd_boot_config device_eui || true)"
    case "$sd_eui" in
        ????????????)
            printf '%s\n' "$sd_eui"
            return 0
            ;;
    esac
    env_eui="$(read_fwenv fieldmesh_device_eui || true)"
    case "$env_eui" in
        ????????????)
            printf '%s\n' "$env_eui"
            return 0
            ;;
    esac
    read_identity_file /etc/fieldmesh/device_eui && return 0
    return 1
}

read_first_line_file() {
    path="$1"
    [ -f "$path" ] || return 1
    sed -n '1p' "$path" 2>/dev/null | tr -d '\r\n\t '
}

read_sd_boot_config() {
    key="$1"
    [ -b /dev/mmcblk0p1 ] || return 1
    mount_dir=/tmp/fieldmesh-sd-config
    mounted_here=0
    mkdir -p "$mount_dir" 2>/dev/null || return 1
    if ! grep -q " $mount_dir " /proc/mounts; then
        mount -o ro -t vfat /dev/mmcblk0p1 "$mount_dir" 2>/dev/null || return 1
        mounted_here=1
    fi
    value=""
    for path in "$mount_dir/fieldmesh_$key" "$mount_dir/$key"; do
        if [ -f "$path" ]; then
            value="$(sed -n '1p' "$path" 2>/dev/null | tr -d '\r\n\t ')"
            [ -n "$value" ] && break
        fi
    done
    if [ "$mounted_here" -eq 1 ]; then
        umount "$mount_dir" 2>/dev/null || true
    fi
    [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

read_gnss_device() {
    [ -n "${FIELDMESH_GNSS_NMEA_DEVICE:-}" ] && {
        printf '%s\n' "$FIELDMESH_GNSS_NMEA_DEVICE"
        return 0
    }
    read_first_line_file /mnt/jffs2/fieldmesh/gnss_nmea_device && return 0
    read_first_line_file /etc/fieldmesh/gnss_nmea_device && return 0
    read_sd_boot_config gnss_nmea_device && return 0
    read_fwenv fieldmesh_gnss_nmea_device && return 0
    return 1
}

read_gnss_baud() {
    case "${FIELDMESH_GNSS_NMEA_BAUD:-}" in
        4800|9600|19200|38400|57600|115200)
            printf '%s\n' "$FIELDMESH_GNSS_NMEA_BAUD"
            return 0
            ;;
    esac
    value="$(read_first_line_file /mnt/jffs2/fieldmesh/gnss_nmea_baud 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_first_line_file /etc/fieldmesh/gnss_nmea_baud 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_sd_boot_config gnss_nmea_baud 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_fwenv fieldmesh_gnss_nmea_baud 2>/dev/null || true)"
    case "$value" in
        4800|9600|19200|38400|57600|115200)
            printf '%s\n' "$value"
            return 0
            ;;
    esac
    printf '%s\n' "$GNSS_BAUD"
}

read_gnss_pps_lock() {
    case "${FIELDMESH_GNSS_PPS_LOCK:-}" in
        0|1)
            printf '%s\n' "$FIELDMESH_GNSS_PPS_LOCK"
            return 0
            ;;
    esac
    value="$(read_first_line_file /mnt/jffs2/fieldmesh/gnss_pps_lock 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_first_line_file /etc/fieldmesh/gnss_pps_lock 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_sd_boot_config gnss_pps_lock 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_fwenv fieldmesh_gnss_pps_lock 2>/dev/null || true)"
    case "$value" in
        0|1)
            printf '%s\n' "$value"
            return 0
            ;;
    esac
    printf '%s\n' "$GNSS_PPS_LOCK"
}

read_gnss_max_reports() {
    case "${FIELDMESH_GNSS_NMEA_MAX_REPORTS:-}" in
        ''|*[!0-9]*)
            ;;
        *)
            if [ "$FIELDMESH_GNSS_NMEA_MAX_REPORTS" -le 1024 ]; then
                printf '%s\n' "$FIELDMESH_GNSS_NMEA_MAX_REPORTS"
                return 0
            fi
            ;;
    esac
    value="$(read_first_line_file /mnt/jffs2/fieldmesh/gnss_nmea_max_reports 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_first_line_file /etc/fieldmesh/gnss_nmea_max_reports 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_sd_boot_config gnss_nmea_max_reports 2>/dev/null || true)"
    [ -n "$value" ] || value="$(read_fwenv fieldmesh_gnss_nmea_max_reports 2>/dev/null || true)"
    case "$value" in
        ''|*[!0-9]*)
            printf '%s\n' "$GNSS_MAX_REPORTS"
            return 0
            ;;
        *)
            if [ "$value" -le 1024 ]; then
                printf '%s\n' "$value"
                return 0
            fi
            ;;
    esac
    printf '%s\n' "$GNSS_MAX_REPORTS"
}

log_gnss_event() {
    event="$1"
    ok="$2"
    reason="$3"
    rotate_named_log_if_needed "$GNSS_LOGFILE" "$GNSS_LOG_MAX_BYTES" "$GNSS_LOG_BACKUPS"
    printf '{"event":"%s","ok":%s,"reason":"%s"}\n' "$event" "$ok" "$reason" >> "$GNSS_LOGFILE"
}

start_gnss_reporter() {
    device="$1"
    eui="$2"
    if [ ! -x "$GNSS_REPORTER" ]; then
        log_gnss_event fieldmesh_gnss_reporter_skip false reporter_missing
        return 0
    fi
    if [ -z "$device" ]; then
        log_gnss_event fieldmesh_gnss_reporter_skip false no_gnss_nmea_device_configured
        return 0
    fi
    if [ ! -e "$device" ]; then
        log_gnss_event fieldmesh_gnss_reporter_skip false gnss_nmea_device_missing
        return 0
    fi
    case "$eui" in
        ????????????)
            ;;
        *)
            log_gnss_event fieldmesh_gnss_reporter_skip false invalid_device_eui
            return 0
            ;;
    esac
    if [ -f "$GNSS_PIDFILE" ] && kill -0 "$(cat "$GNSS_PIDFILE")" 2>/dev/null; then
        log_gnss_event fieldmesh_gnss_reporter_status true already_running
        return 0
    fi
    baud="$(read_gnss_baud)"
    max_reports="$(read_gnss_max_reports)"
    pps_lock="$(read_gnss_pps_lock)"
    log_gnss_event fieldmesh_gnss_reporter_start true starting
    nohup "$0" run-gnss "$device" "$eui" "$baud" "$max_reports" "$pps_lock" > /dev/null 2>&1 &
    echo "$!" > "$GNSS_PIDFILE"
}

rotate_named_log_if_needed() {
    log_file="$1"
    max_bytes="$2"
    backups="$3"
    [ -f "$log_file" ] || return 0
    size="$(wc -c < "$log_file" 2>/dev/null || echo 0)"
    case "$size" in
        ''|*[!0-9]*)
            return 0
            ;;
    esac
    case "$max_bytes" in
        ''|*[!0-9]*)
            max_bytes=262144
            ;;
    esac
    case "$backups" in
        ''|*[!0-9]*)
            backups=2
            ;;
    esac
    [ "$size" -lt "$max_bytes" ] && return 0
    index="$backups"
    while [ "$index" -gt 1 ]; do
        prev=$((index - 1))
        [ -f "$log_file.$prev" ] && mv "$log_file.$prev" "$log_file.$index"
        index="$prev"
    done
    [ -f "$log_file" ] && mv "$log_file" "$log_file.1"
    : > "$log_file"
}

rotate_log_if_needed() {
    rotate_named_log_if_needed "$LOGFILE" "$LOG_MAX_BYTES" "$LOG_BACKUPS"
}

run_with_rotating_log() {
    "$DAEMON" serve 0.0.0.0 "$PORT" "$REQUESTS" "$TIMEOUT_MS" 2>&1 |
    while IFS= read -r line; do
        rotate_log_if_needed
        printf '%s\n' "$line" >> "$LOGFILE"
    done
}

run_gnss_with_rotating_log() {
    device="$1"
    eui="$2"
    baud="$3"
    max_reports="$4"
    pps_lock="$5"
    "$GNSS_REPORTER" "$device" 127.0.0.1 "$PORT" "$eui" "$baud" "$max_reports" "$pps_lock" 2>&1 |
    while IFS= read -r line; do
        rotate_named_log_if_needed "$GNSS_LOGFILE" "$GNSS_LOG_MAX_BYTES" "$GNSS_LOG_BACKUPS"
        printf '%s\n' "$line" >> "$GNSS_LOGFILE"
    done
}

case "$1" in
    start|"")
        [ -x "$DAEMON" ] || exit 0
        env_port="$(read_fwenv fieldmesh_daemon_port || true)"
        env_eui="$(read_device_eui || true)"
        case "$env_port" in
            ''|*[!0-9]*)
                ;;
            *)
                PORT="$env_port"
                ;;
        esac
        case "$env_eui" in
            ????????????)
                export FIELDMESH_DEVICE_EUI="$env_eui"
                ;;
        esac
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            exit 0
        fi
        mkdir -p /var/run
        nohup "$0" run > /dev/null 2>&1 &
        echo "$!" > "$PIDFILE"
        gnss_device="$(read_gnss_device || true)"
        start_gnss_reporter "$gnss_device" "$env_eui"
        ;;
    run)
        [ -x "$DAEMON" ] || exit 0
        run_with_rotating_log
        ;;
    run-gnss)
        [ -x "$GNSS_REPORTER" ] || exit 0
        run_gnss_with_rotating_log "$2" "$3" "$4" "$5" "$6"
        ;;
    stop)
        if [ -f "$GNSS_PIDFILE" ]; then
            kill "$(cat "$GNSS_PIDFILE")" 2>/dev/null || true
            rm -f "$GNSS_PIDFILE"
        fi
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "fieldmesh-state-daemon running"
            exit 0
        fi
        echo "fieldmesh-state-daemon stopped"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac

exit 0
