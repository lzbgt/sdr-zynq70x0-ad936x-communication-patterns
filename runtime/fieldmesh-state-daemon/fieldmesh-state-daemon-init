#!/bin/sh

DAEMON=/usr/bin/fieldmesh-state-daemon-demo
PIDFILE=/var/run/fieldmesh-state-daemon.pid
LOGFILE=/tmp/fieldmesh-state-daemon.ndjson
LOG_MAX_BYTES=262144
LOG_BACKUPS=2
PORT=55441
REQUESTS=0
TIMEOUT_MS=5000

read_fwenv() {
    key="$1"
    command -v fw_printenv >/dev/null 2>&1 || return 1
    fw_printenv -n "$key" 2>/dev/null | tr -d '\r\n'
}

read_identity_file() {
    path="$1"
    [ -f "$path" ] || return 1
    value="$(sed -n '1p' "$path" 2>/dev/null | tr -d '\r\n\t ')"
    case "$value" in
        ????????????)
            printf '%s\n' "$value"
            return 0
            ;;
    esac
    return 1
}

read_device_eui() {
    read_identity_file /mnt/jffs2/fieldmesh/device_eui && return 0
    env_eui="$(read_fwenv fieldmesh_device_eui || true)"
    case "$env_eui" in
        ????????????)
            printf '%s\n' "$env_eui"
            return 0
            ;;
    esac
    read_identity_file /etc/fieldmesh/device_eui && return 0
    return 1
}

rotate_log_if_needed() {
    [ -f "$LOGFILE" ] || return 0
    size="$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)"
    case "$size" in
        ''|*[!0-9]*)
            return 0
            ;;
    esac
    [ "$size" -lt "$LOG_MAX_BYTES" ] && return 0
    index="$LOG_BACKUPS"
    while [ "$index" -gt 1 ]; do
        prev=$((index - 1))
        [ -f "$LOGFILE.$prev" ] && mv "$LOGFILE.$prev" "$LOGFILE.$index"
        index="$prev"
    done
    [ -f "$LOGFILE" ] && mv "$LOGFILE" "$LOGFILE.1"
    : > "$LOGFILE"
}

run_with_rotating_log() {
    "$DAEMON" serve 0.0.0.0 "$PORT" "$REQUESTS" "$TIMEOUT_MS" 2>&1 |
    while IFS= read -r line; do
        rotate_log_if_needed
        printf '%s\n' "$line" >> "$LOGFILE"
    done
}

case "$1" in
    start|"")
        [ -x "$DAEMON" ] || exit 0
        env_port="$(read_fwenv fieldmesh_daemon_port || true)"
        env_eui="$(read_device_eui || true)"
        case "$env_port" in
            ''|*[!0-9]*)
                ;;
            *)
                PORT="$env_port"
                ;;
        esac
        case "$env_eui" in
            ????????????)
                export FIELDMESH_DEVICE_EUI="$env_eui"
                ;;
        esac
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            exit 0
        fi
        mkdir -p /var/run
        nohup "$0" run > /dev/null 2>&1 &
        echo "$!" > "$PIDFILE"
        ;;
    run)
        [ -x "$DAEMON" ] || exit 0
        run_with_rotating_log
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE")" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            echo "fieldmesh-state-daemon running"
            exit 0
        fi
        echo "fieldmesh-state-daemon stopped"
        exit 1
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 1
        ;;
esac

exit 0
